# Portable SSH config for CTF.
# Personal hosts and keys go to ~/.ssh/config.local (not in this repo).
Include ~/.ssh/config.local*

Host *
    AddKeysToAgent yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive yes
    HashKnownHosts yes
    Compression yes
    ControlMaster auto
    ControlPath ~/.ssh/cm/%C
    ControlPersist 10m

# Example target. Copy to ~/.ssh/config.local and adjust.
# Host target
#     HostName 10.10.10.10
#     User player
#     Port 22
#     IdentityFile ~/.ssh/id_ctf
#     IdentitiesOnly yes
